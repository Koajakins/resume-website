---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.haggath.re/" },
    { "@type": "ListItem", "position": 2, "name": "Writing", "item": "https://www.haggath.re/blog/" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "https://www.haggath.re/blog{{ page.url }}" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ excerpt or description }}",
  "datePublished": "{{ date | isoDateString }}",
  "dateModified": "{{ (updated or date) | isoDateString }}",
  "image": {
    "@type": "ImageObject",
    "url": "https://www.haggath.re/assets/og-card.jpg",
    "width": 1200,
    "height": 630
  },
  "url": "https://www.haggath.re/blog{{ page.url }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.haggath.re/blog{{ page.url }}" },
  "author": {
    "@type": "Person",
    "@id": "https://www.haggath.re/#person",
    "name": "Thomas Haggath",
    "url": "https://www.haggath.re/"
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://www.haggath.re/#person",
    "name": "Thomas Haggath",
    "url": "https://www.haggath.re/",
    "logo": { "@type": "ImageObject", "url": "https://www.haggath.re/assets/og-card.jpg", "width": 1200, "height": 630 }
  }
}
</script>
{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.answer | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}

    {% endfor %}
  ]
}
</script>
{% endif %}
<div class="blog-prose">
  <a href="/blog/" class="back-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    All posts
  </a>
  <h1>{{ title }}</h1>
  <p class="post-meta"><time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% if updated %} &middot; Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time>{% endif %} &middot; {{ content | readingTime }} min read</p>
  {{ content | safe }}
  {% set postList = collections.posts %}
  {% set currentIndex = 0 %}
  {% for p in postList %}
    {% if p.url == page.url %}{% set currentIndex = loop.index0 %}{% endif %}
  {% endfor %}
  {% set prevPost = postList[currentIndex + 1] %}
  {% set nextPost = postList[currentIndex - 1] if currentIndex > 0 else null %}
  <aside class="author-bio">
    <img src="https://www.haggath.re/assets/profile.webp" alt="Thomas Haggath" width="56" height="56" loading="lazy">
    <div class="author-bio-text">
      <strong>Thomas Haggath</strong>
      <p>Senior Cloud Support Engineer with 7+ years at Amazon Web Services. Specialises in AWS security incident response, detection engineering, GuardDuty, and security patching across enterprise multi-account environments. <a href="https://www.haggath.re/">haggath.re</a></p>
    </div>
  </aside>
  {% if prevPost or nextPost %}
  <nav class="post-nav" aria-label="Post navigation">
    <div class="post-nav-inner">
      {% if prevPost %}
      <a href="{{ prevPost.url }}" class="post-nav-link post-nav-prev">
        <span class="post-nav-dir">← Older</span>
        <span class="post-nav-title">{{ prevPost.data.title }}</span>
      </a>
      {% else %}<div></div>{% endif %}
      {% if nextPost %}
      <a href="{{ nextPost.url }}" class="post-nav-link post-nav-next">
        <span class="post-nav-dir">Newer →</span>
        <span class="post-nav-title">{{ nextPost.data.title }}</span>
      </a>
      {% else %}<div></div>{% endif %}
    </div>
  </nav>
  {% endif %}
</div>
